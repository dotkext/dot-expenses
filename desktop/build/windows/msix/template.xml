<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="dot-expenses.exe"
        Arguments=""
        InstallLocation="C:\Program Files\dotkext\dot-expenses">
    </Installer>
    <PackageInformation
        PackageName="dot-expenses"
        PackageDisplayName="dot-expenses"
        PublisherName="CN=dotkext"
        PublisherDisplayName="dotkext"
        Version="0.1.0.0"
        PackageDescription="Local-first expense and budget tracker">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.dotkext.dotexpenses"
                Description="Local-first expense and budget tracker"
                DisplayName="dot-expenses"
                ExecutableName="dot-expenses.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>dot-expenses</DisplayName>
            <PublisherDisplayName>dotkext</PublisherDisplayName>
            <Description>Local-first expense and budget tracker</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="dot-expenses.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
