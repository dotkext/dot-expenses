# Required — external PostgreSQL connection string.
# The bundled docker-compose starts one for you; point this at any Postgres.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dot_expenses

# Port the app listens on (inside and outside the container)
PORT=3000

# Public origin of the app, e.g. https://expenses.example.com
# Used for OAuth redirect URIs; falls back to the request origin when unset.
#APP_URL=http://localhost:3000

# Timezone used for "today" / recurring schedules (IANA name)
#TZ=UTC

# Optional: Google sign-in. Both must be set to enable it.
# Redirect URI to register in Google Cloud Console:
#   {APP_URL}/auth/google/callback
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# Optional: secret for the external cron trigger (POST /api/cron/run
# with "Authorization: Bearer <secret>"). The in-process scheduler runs anyway.
#CRON_SECRET=

# Set to true for offline installs: disables automatic exchange-rate fetching.
# Manual rate overrides in Settings still work.
#EXCHANGE_RATES_DISABLED=false

# Set to false to disable automatic migrations on boot (run drizzle-kit yourself).
#AUTO_MIGRATE=true
